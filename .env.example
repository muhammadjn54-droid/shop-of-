# Base URL of the Django backend, no trailing slash and NO /api suffix
# (the app appends /api/... to every call itself).
#
# Vercel deployment:
VITE_API_URL=https://shop-becend.vercel.app
#
# Render deployment - replace with your own service URL and restart/rebuild:
# VITE_API_URL=https://shop-backend.onrender.com
